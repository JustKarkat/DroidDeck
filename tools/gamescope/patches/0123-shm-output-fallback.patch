+    // ImportDmabufToBackend has nothing to import.
+    OwningRc<CWaylandFb> CWaylandFb::CreateShmFb( CWaylandBackend *pBackend, ::CVulkanTexture *pTexture )
+    {
+        uint32_t nRowPitch = pTexture->rowPitch();
+        uint32_t uHeight = pTexture->height();
+        size_t uStride = nRowPitch;
+        size_t uSize = uStride * uHeight;
+
+        xdg_log.infof( "0123-shm: allocating %ux%u shm buffer, size=%zu stride=%zu", pTexture->width(), pTexture->height(), uSize, uStride );
+
+        // Not using CreateShmBuffer(): it mkostemps a file in $XDG_RUNTIME_DIR,
+        // which on the prooted Shield TV guest is not reliably mmap-able
+        // MAP_SHARED. A memfd created with the raw syscall works everywhere the
+        // guest kernel has memfd_create (upstream 3.17+; this device is 4.9).
+        int32_t nFd = (int32_t)syscall( SYS_memfd_create, "gamescope-shm", 0 );
+        if ( nFd < 0 )
+        {
+            xdg_log.errorf( "0123-shm: memfd_create failed: %s", strerror( errno ) );
+            return nullptr;
+        }
+
+        if ( ftruncate( nFd, uSize ) < 0 )
+        {
+            xdg_log.errorf( "0123-shm: ftruncate(%zu) failed: %s", uSize, strerror( errno ) );
+            close( nFd );
+            return nullptr;
+        }
+
+        void *pMappedData = mmap( nullptr, uSize, PROT_READ | PROT_WRITE, MAP_SHARED, nFd, 0 );
+        if ( pMappedData == MAP_FAILED )
+        {
+            xdg_log.errorf( "0123-shm: mmap(%zu) failed: %s", uSize, strerror( errno ) );
+            close( nFd );
+            return nullptr;
+        }
+
+        wl_shm *pShm = pBackend->GetShm();
+        wl_shm_pool *pPool = wl_shm_create_pool( pShm, nFd, uSize );
+        close( nFd );
+        if ( pPool == nullptr )
+        {
+            xdg_log.errorf( "0123-shm: failed to create wl_shm_pool" );
+            munmap( pMappedData, uSize );
+            return nullptr;
+        }
+
+        wl_buffer *pBuffer = wl_shm_pool_create_buffer( pPool, 0, pTexture->width(), pTexture->height(), uStride, WL_SHM_FORMAT_XRGB8888 );
+        if ( pBuffer == nullptr )
+        {
+            xdg_log.errorf( "0123-shm: failed to create wl_buffer" );
+            wl_shm_pool_destroy( pPool );
+            munmap( pMappedData, uSize );
+            return nullptr;
+        }
+
+        OwningRc<CWaylandFb> pFb = new CWaylandFb( pBackend, pBuffer );
+        pFb->m_pPool = pPool;
+        pFb->m_pShmData = (uint8_t *)pMappedData;
+        pFb->m_uShmSize = uSize;
+        pFb->m_uShmStride = uStride;
+        xdg_log.infof( "0123-shm: shm fb %ux%u stride %zu", pTexture->width(), pTexture->height(), uStride );
+        return pFb;
+    }
