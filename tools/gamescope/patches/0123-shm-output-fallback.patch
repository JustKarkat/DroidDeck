+    // Copy the texture's current content into the shm buffer.
+    void CWaylandFb::FlushShm( ::CVulkanTexture *pTexture )
+    {
+        if ( m_pShmData == nullptr )
+            return;
+
+        // CPU-visible mapping: when the ICD cannot export DMA_BUF, textures this
+        // fb wraps were created with bMappable (vulkan_make_output sets it), so
+        // mappedData/rowPitch are valid. Sizes are identical (rowPitch == stride).
+        if ( !pTexture->mappedData() )
+        {
+            xdg_log.errorf( "0123-shm: texture has no CPU mapping; cannot flush" );
+            return;
+        }
+
+        memcpy( m_pShmData, pTexture->mappedData(), m_uShmSize );
     }
 
