+void CVulkanCmdBuffer::copyImageToBuffer(VkBuffer buffer, VkDeviceSize offset, uint32_t stride, gamescope::Rc<CVulkanTexture> src)
+{
+	VkBufferImageCopy region = {
+		.bufferOffset = offset,
+		.bufferRowLength = stride,
+		.imageSubresource = {
+			.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+			.layerCount = 1,
+		},
+		.imageExtent = {
+			.width = src->width(),
+			.height = src->height(),
+			.depth = 1,
+		},
+	};
+
+	m_device->vk.CmdCopyImageToBuffer(m_cmdBuffer, src->vkImage(), VK_IMAGE_LAYOUT_GENERAL, buffer, 1, &region);
+
+	m_textureRefs.emplace_back(std::move(src));
+}
