#!/bin/bash
set -eu
cdn=https://client-update.fastly.steamstatic.com
steam_channel=steamdeck_publicbeta
manifest=steam_client_${steam_channel}_linuxarm64
steam_root=${XDG_DATA_HOME:-$HOME/.local/share}/Steam
stamp=$steam_root/package/droiddeck-installed
legacy_stamp=$steam_root/package/bannerlator-installed
unconfirmed=$steam_root/package/droiddeck-unconfirmed
repair_request=$HOME/.bl-steam-repair
if [ -f "$legacy_stamp" ] && [ ! -f "$stamp" ]; then
  mv -f "$legacy_stamp" "$stamp" || true
fi
pinned_version=1776387948
# ponytail: pinned to the last ARMv8.0-compatible Steam client. Valve raised the
# native ARM64 client to Armv8.1 (LSE atomics required) after build 1776387948
# (2026-04-15), and CPUs without LSE — Cortex-A53/A57/A72/A73, including the
# Shield TV's Cortex-A57 — SIGILL immediately (steam-for-linux#13288). Valve's
# CDN still serves this build's parts; SteamTracking archives its manifest.
# Unpin only when Valve ships a client that runs on ARMv8.0 again: bump
# pinned_version and point pinned_manifest back at "$cdn/$manifest".
pinned_manifest=https://raw.githubusercontent.com/SteamTracking/SteamTracking/f58aaa973df1f21e1208f6d65b448db677ec31e8/ClientManifest/steam_client_publicbeta_linuxarm64
repair=""
installed_version=$(cat "$stamp" 2>/dev/null || echo 0)
if [ -f "$stamp" ] && ! grep -qa atomics /proc/cpuinfo 2>/dev/null \
  && [ "$installed_version" -gt "$pinned_version" ] 2>/dev/null; then
  # pin-catch: the installed client is newer than the pin and this CPU has no LSE
  echo "droiddeck-steam-install: installed client $installed_version requires LSE atomics; reinstalling pinned $pinned_version"
  repair="the installed client needs LSE atomics this CPU lacks"
fi
if [ -e "$repair_request" ]; then
  repair="requested"
elif [ -f "$unconfirmed" ] && ! grep -qx repaired "$unconfirmed" \
    && [ "$(grep -cx start "$unconfirmed")" -ge 2 ]; then
  repair="the client was started $(grep -cx start "$unconfirmed") times without showing anything"
fi
if [ -n "$repair" ]; then
  echo "== STEP $(date -u +%H:%M:%S) repairing the Steam client ($repair)"
  rm -f "$stamp" "$legacy_stamp" "$steam_root/.crash" "$steam_root/steam.pid" \
    "$steam_root"/package/steam_client_*.manifest "$steam_root"/package/steam_client_*.installed
  for part in "$steam_root"/package/*.zip.*; do
    [ -f "$part" ] || continue
    sum=${part##*.}
    sum=${sum%%_*}
    case $sum in
      *[!0-9a-f]*|"") continue ;;
    esac
    [ ${#sum} -eq 40 ] || continue
    [ "$(sha1sum "$part" | cut -d' ' -f1)" = "$sum" ] || rm -f "$part"
  done
fi
# BootStrapperInhibitAll: the client's own update-inhibit switch (Steam.cfg in the
# steam root). Every live channel's client is LSE-only (ARMv8.1) and would SIGILL
# on this CPU when applied (steam-for-linux#13288), so self-update must never run.
# Combined with the pinned manifest above; also stops switch-to-stable fallbacks.
# Written before the early-exit so already-installed trees get it too.
echo BootStrapperInhibitAll=Enable > "$steam_root/Steam.cfg"
[ -x "$steam_root/steamrtarm64/steam" ] && [ -f "$stamp" ] && exit 0

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# The pinned manifest replaces the live-channel fetch; see pinned_version above.
curl -fsSL "$pinned_manifest" -o "$work/manifest" \
  || { echo "droiddeck-steam-install: pinned manifest $pinned_manifest unreachable, falling back to live channel" >&2; curl -fsSL "$cdn/$manifest" -o "$work/manifest"; }
version=$(awk -F'"' '$2 == "version" { print $4; exit }' "$work/manifest")
awk -F'"' '
  /^\t"/ && NF >= 3 && $4 == "" { block = $2 }
  $2 == "file" { file[block] = $4 }
  $2 == "sha2" { sha[block] = $4 }
  END { for (b in file) if (b ~ /_all$/ || b ~ /_linuxarm64_linuxarm64$/) print b, file[b], sha[b] }
' "$work/manifest" | sort > "$work/parts"
[ -s "$work/parts" ] || { echo "droiddeck-steam-install: no client components in $manifest" >&2; exit 1; }
total=$(grep -c . "$work/parts" 2>/dev/null || echo 0)

mkdir -p "$steam_root/package"
while read -r block file sum; do
  i=$((${i:-0} + 1))
  echo "== STEP $(date -u +%H:%M:%S) downloading Steam: $block ($i/$total)"
  curl -fsSL "$cdn/$file" -o "$work/$file"
  echo "$sum  $work/$file" | sha256sum -c --quiet
  unzip -qo "$work/$file" -d "$steam_root"
  rm -f "$work/$file"
done < "$work/parts"
find "$steam_root" -depth -name '*\\*' | while read -r odd; do
  fixed=${odd//\\//}
  mkdir -p "$(dirname "$fixed")"
  if [ -d "$odd" ]; then
    cp -a "$odd/." "$fixed/" && rm -rf "$odd"
  else
    mv -f "$odd" "$fixed"
  fi
done
# Valve's client zips ship the ELFs non-executable; the bootstrapper
# shells out to steamsysinfo/steamwebhelper.sh and dies otherwise. Exec-bit every
# ELF + .sh under the client trees (dirs are already x).
find "$steam_root/steamrtarm64" "$steam_root/linuxarm64" -type f 2>/dev/null | while read -r elf; do
  case $elf in *.sh) chmod a+x "$elf"; continue ;; esac
  [ "$(head -c4 "$elf" 2>/dev/null)" = "$(printf '\177ELF')" ] && chmod a+x "$elf"
done
# droiddeck-pinned-v8.0: fake beta channel so the client's own updater can't
# re-download an LSE-only client over the pinned ARMv8.0 build (see droiddeck-session).
echo droiddeck-pinned-v8.0 > "$steam_root/package/beta"
ln -sfn "$steam_root/steamrtarm64" "$steam_root/steamrtarm32"
chmod +x "$steam_root/steamrtarm64/steam" 2>/dev/null || true
mkdir -p "$HOME/.steam"
ln -sfn "$steam_root" "$HOME/.steam/root"
ln -sfn "$steam_root" "$HOME/.steam/steam"
ln -sfn "$steam_root/steamrtarm64" "$HOME/.steam/bin64"
ln -sfn "$steam_root/linuxarm64" "$HOME/.steam/sdk64"
ln -sfn "$steam_root/linuxarm64" "$HOME/.steam/sdkarm64"
ln -sfn "$steam_root/steamrtarm64" "$HOME/.steam/binarm64"
ln -sfn "$steam_root/linux32" "$HOME/.steam/sdk32"
echo "$version" > "$stamp"
if [ -n "$repair" ]; then
  echo repaired > "$unconfirmed"
  rm -f "$repair_request"
fi
