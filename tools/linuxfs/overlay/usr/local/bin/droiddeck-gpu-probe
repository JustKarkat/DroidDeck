#!/bin/bash
# GPU feasibility probe: initialise the vendor EGL driver from the glibc guest
# through libhybris. Run as `droiddeck-gpu-probe [eglprobe args...]`; success is
# the "RESULT GL_RENDERER=NVIDIA Tegra" line, failure prints the faulting
# mapping from the in-process SIGSEGV handler.
#
# /usr/local/hybris/bionic (Halium-patched bionic, see tools/hybris/build-in-arch.sh)
# must stay FIRST in HYBRIS_LD_LIBRARY_PATH: stock Android 11 bionic reads TLS
# inline (mrs tpidr_el0) and no longer exports __get_tls_hooks, which libhybris
# interposes — with the stock libc the probe segfaults inside bionic during
# eglGetDisplay.
set -e

hybris=/usr/local/hybris/usr/lib

# The APK cannot carry symlinks; restore the soname links next to the real
# versioned libraries (libEGL.so.1.0.0 needs libEGL.so.1 and libEGL.so), plus
# the pkglibdir path libhybris dlopens its EGL platform backend from
# (compiled-in /usr/lib/libhybris).
for real in "$hybris"/*.so.*.*.*; do
    [ -f "$real" ] || continue
    soname=${real%.*.*}                  # .../libEGL.so.1 (the DT_SONAME)
    ln -sfn "${real##*/}" "$soname"
    ln -sfn "${real##*/}" "${soname%.*}" # .../libEGL.so
done
ln -sfn /usr/local/hybris/usr/lib/libhybris /usr/lib/libhybris

export LD_LIBRARY_PATH=$hybris
# /vendor/lib64/hw is required for Vulkan: the tegra HAL's open() dlopens
# "vulkan.tegra.so" by soname to find its driver entrypoints.
export HYBRIS_LD_LIBRARY_PATH=/usr/local/hybris/bionic:/system/lib64:/vendor/lib64:/vendor/lib64/hw:/vendor/lib64/egl:/apex/com.android.runtime/lib64/bionic

rc=0
/usr/local/hybris/usr/bin/eglprobe "$@" || rc=$?
if [ -x /usr/local/hybris/usr/bin/vkprobe ]; then
    # Vulkan goes through the same patched bionic; the hybris wrapper dlopens
    # the Android loader (libvulkan.so) which loads the tegra ICD. The loader
    # names the ICD via properties, so log what it will see.
    echo "== vulkan-hal:"
    /usr/local/hybris/usr/bin/getprop ro.hardware.vulkan || true
    /usr/local/hybris/usr/bin/getprop ro.board.platform || true
    # statx is ENOSYS under proot here; don't let the failing ls (or its
    # exit code) stop the script before vkprobe runs.
    ls -la /vendor/lib64/hw/vulkan.*.so 2>&1 || true
    export HYBRIS_VULKANPLATFORM=null
    /usr/local/hybris/usr/bin/vkprobe "$@" || rc=$?
fi
# The path gamescope will use: the guest's Mesa loader + the sysvk ICD
# (hw_get_module -> HAL device -> driver, no Android loader).
icd=/usr/local/hybris/usr/share/vulkan/icd.d/sysvk_icd.json
if [ -f "$icd" ]; then
    echo "== vulkaninfo via sysvk ICD:"
    export VK_ICD_FILENAMES=$icd VK_DRIVER_FILES=$icd
    vulkaninfo --summary > /tmp/vulkaninfo.out 2>&1 || true
    echo "vulkaninfo exit=$?"
    head -40 /tmp/vulkaninfo.out || true
fi
exit $rc
