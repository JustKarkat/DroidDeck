#!/usr/bin/env python3
# droiddeck-cef-patch: swap Valve's forced ANGLE backend (swiftshader-webgl)
# for a native one so Steam's CEF GPU process can bind the Tegra GLES driver
# via the hybris-egl LD_LIBRARY_PATH (BL_CEF_ANGLE selects it, default
# gles-egl — ANGLE's DisplayEGL requests EGL_OPENGL_ES3_BIT there and only
# dlopens libEGL.so.1). Idempotent; safe to run on every launch.
# Exit codes: 0 patched or already patched, 3 client layout changed
# (neither string found), 4 unexpected layout (too many sites).
import hashlib, os, shutil, sys

LIB = sys.argv[1] if len(sys.argv) > 1 else "/root/.local/share/Steam/steamrtarm64/libcef.so"
OLD = b"swiftshader-webgl\0"
NEW = (os.environ.get("BL_CEF_ANGLE", "gles-egl").encode() + b"\0")[: len(OLD) - 1]
assert len(NEW) <= len(OLD) - 1

data = bytearray(open(LIB, "rb").read())
n_old = data.count(OLD)
n_new = data.count(bytes(NEW.ljust(len(OLD), b"\0")))
if n_old > 4:
    sys.exit(4)
if n_old == 0 and n_new == 0:
    sys.exit(3)
bak = LIB + ".droiddeck-bak"
if not os.path.exists(bak):
    shutil.copy2(LIB, bak)
    open(bak + ".sha256", "w").write(hashlib.sha256(data).hexdigest())

# DisplayType fix: Valve's fork maps its forced-backend string to its OWN
# DisplayType 14 (the SwiftShader-device path) in the display-list builder —
# patching the string alone still lands on SwiftShader. Valve's enum puts
# ANGLE_OPENGLES_EGL at 16 (switch case at libcef+0x77dcc28: attribs
# DEVICE_TYPE=0x3209 + EGL=0x348e, GetPlatformANGLEDisplay type 0x320e), so
# rewrite the `mov w10, #14` at the string-match site (vaddr 0x7872bd0) to
# `mov w10, #16`. Idempotent via the surrounding 12-byte pattern.
DT_SITE = 0x7862bcc  # file offset of the 12-byte pattern (vaddr 0x7872bcc; file = vaddr - 0x10000)
DT_OLD = bytes.fromhex("682640a9ca018052aac31fb8")   # ldp x8,x9,[x19]; mov w10,#14; stur w10,[x29,#-4]
DT_NEW = bytes.fromhex("682640a90a028052aac31fb8")   # same, mov w10,#16
if n_old:
    data[n_old and 0:0] = b""  # no-op, keep bytearray type
    data[:] = bytes(data).replace(OLD, NEW.ljust(len(OLD), b"\0"))
    data = bytearray(data)
if bytes(data[DT_SITE:DT_SITE + len(DT_OLD)]) == DT_OLD:
    data[DT_SITE:DT_SITE + len(DT_OLD)] = DT_NEW
    dt_msg = "dt14->dt16 patched"
elif bytes(data[DT_SITE:DT_SITE + len(DT_OLD)]) == DT_NEW:
    dt_msg = "dt14->dt16 already patched"
else:
    dt_msg = "dt site moved (client layout changed?); string-only patch"

open(LIB + ".tmp", "wb").write(bytes(data))
shutil.copymode(LIB, LIB + ".tmp")
os.replace(LIB + ".tmp", LIB)
print("patched", n_old, "site(s) ->", NEW.decode().strip("\0") + ";" + dt_msg)
